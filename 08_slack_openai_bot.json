{
  "name": "Slack Slash Command → AI Assistant",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "slack-ai", "responseMode": "responseNode" },
      "name": "Webhook (Slack)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "messages": {
          "values": [
            { "role": "system", "content": "You are a helpful work assistant. Be concise." },
            { "role": "user", "content": "={{ $json.body.text }}" }
          ]
        }
      },
      "name": "OpenAI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"response_type\": \"in_channel\", \"text\": \"{{ $json.message.content }}\" }"
      },
      "name": "Respond to Slack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook (Slack)": { "main": [[{ "node": "OpenAI", "type": "main", "index": 0 }]] },
    "OpenAI": { "main": [[{ "node": "Respond to Slack", "type": "main", "index": 0 }]] }
  }
}
