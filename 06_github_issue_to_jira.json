{
  "name": "GitHub Issue → Jira Ticket",
  "nodes": [
    {
      "parameters": { "events": ["issues"], "owner": "={{ $env.GITHUB_OWNER }}", "repository": "={{ $env.GITHUB_REPO }}" },
      "name": "GitHub Trigger",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": { "string": [{ "value1": "={{ $json.action }}", "operation": "equals", "value2": "opened" }] }
      },
      "name": "Filter: Opened Only",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "project": "={{ $env.JIRA_PROJECT_KEY }}",
        "summary": "=[GH] {{ $json.issue.title }}",
        "description": "={{ $json.issue.body }}\n\nGitHub URL: {{ $json.issue.html_url }}",
        "issueType": "Bug"
      },
      "name": "Create Jira Issue",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [720, 200]
    }
  ],
  "connections": {
    "GitHub Trigger": { "main": [[{ "node": "Filter: Opened Only", "type": "main", "index": 0 }]] },
    "Filter: Opened Only": { "main": [[{ "node": "Create Jira Issue", "type": "main", "index": 0 }]] }
  }
}
