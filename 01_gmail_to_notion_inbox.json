{
  "name": "Gmail → Notion Inbox",
  "nodes": [
    {
      "parameters": { "pollTimes": { "item": [{ "mode": "everyMinute" }] }, "filters": { "readStatus": "unread" } },
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": "={{ $env.NOTION_DB_ID }}",
        "title": "={{ $json.subject }}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "From", "type": "rich_text", "textValue": "={{ $json.from.value[0].address }}" },
            { "key": "Date", "type": "date", "dateValue": "={{ $json.date }}" },
            { "key": "Status", "type": "select", "selectValue": "Unread" }
          ]
        }
      },
      "name": "Add to Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [480, 300]
    }
  ],
  "connections": { "Gmail Trigger": { "main": [[{ "node": "Add to Notion", "type": "main", "index": 0 }]] } }
}
