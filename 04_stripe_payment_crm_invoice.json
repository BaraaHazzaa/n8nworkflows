{
  "name": "Stripe Payment → CRM + Invoice",
  "nodes": [
    {
      "parameters": { "events": ["payment_intent.succeeded"] },
      "name": "Stripe Trigger",
      "type": "n8n-nodes-base.stripeTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $json.data.object.receipt_email }}",
        "additionalFields": { "firstname": "={{ $json.data.object.metadata.name }}" }
      },
      "name": "Upsert HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "url": "https://api.invoice-service.com/invoices",
        "method": "POST",
        "body": {
          "amount": "={{ $json.data.object.amount / 100 }}",
          "currency": "={{ $json.data.object.currency }}",
          "customer_email": "={{ $json.data.object.receipt_email }}"
        }
      },
      "name": "Create Invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 420]
    }
  ],
  "connections": {
    "Stripe Trigger": {
      "main": [
        [{ "node": "Upsert HubSpot Contact", "type": "main", "index": 0 }, { "node": "Create Invoice", "type": "main", "index": 0 }]
      ]
    }
  }
}
